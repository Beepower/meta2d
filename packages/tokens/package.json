{
  "name": "@meta2d/tokens",
  "version": "1.0.0",
  "description": "Design tokens for meta2d — three-tier system with type-safe paths",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.0.0",
    "typescript": "^5.3.0",
    "jsdom": "^24.0.0",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
